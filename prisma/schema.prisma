generator client {
  provider        = "prisma-client-js"
  // Load relations with SQL joins in ONE query instead of one query per
  // relation. Each round trip to the database costs ~50 ms in production, so
  // a book list went from 7-8 sequential queries to 1-2.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= ENUMS =================

enum InventoryStatus {
  available
  on_request
  rare
}

enum RequestStatus {
  pending
  contacted
  done
}

enum OrderStatus {
  pending
  confirmed
  shipped
  delivered
  cancelled
}

/// Where a sale came from. All sales live in one register.
enum SaleChannel {
  online // storefront / phone / WhatsApp orders
  shop // sold at the counter
  import // brought in from a spreadsheet (history)
}

enum PaymentMethod {
  cash
  card
  transfer
  cod // cash on delivery
  other
}

/// Why a book's stock changed — every change is logged.
enum StockReason {
  sale
  sale_cancel
  purchase
  purchase_cancel
  adjustment
  import
}

// ================= CORE =================

model Store {
  id    String  @id @default(uuid())
  name  String
  slug  String  @unique
  phone String?

  // Shown on invoices. Algerian invoices carry the trade register (RC),
  // tax id (NIF), statistical id (NIS) and article (AI) numbers.
  address       String?
  email         String?
  rc            String?
  nif           String?
  nis           String?
  art           String?
  invoiceFooter String?

  /// Subscription pack: "starter" | "pro" | "business". Decides which
  /// features the store's admin can use (see src/common/plan/plans.ts).
  plan String @default("business")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books          Book[]
  inventories    Inventory[]
  importJobs     ImportJob[]
  requests       Request[]
  orders         Order[]
  suppliers      Supplier[]
  purchases      Purchase[]
  expenses       Expense[]
  stockMovements StockMovement[]
  counters       StoreCounter[]
}

// ================= BOOK =================

model Book {
  id              String  @id @default(uuid())
  title           String
  titleNormalized String?

  /// Public blurb about the work itself, shown to shoppers on the book page
  /// under "عن الكتاب". Prose, free-form, may be empty.
  description String?

  /// Concrete cataloguing detail the title cannot carry — edition, number of
  /// volumes, binding, printing, condition, series. Shown on the book page
  /// under "معلومات إضافية".
  notes String?

  year      Int?
  price     Decimal? @db.Decimal(10, 2)
  /// What the store paid for it. Admin-only — never sent to the storefront.
  costPrice Decimal? @db.Decimal(10, 2)

  /// The spreadsheet import that created this book, if any (lets an import be undone).
  importJobId String?

  countryId  String?
  categoryId String
  storeId    String

  /// The cover — always the first picture. Kept as its own column because
  /// cards, order lines and the mobile apps read a single image.
  imageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category  Category   @relation(fields: [categoryId], references: [id])
  importJob ImportJob? @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  country   Country?   @relation(fields: [countryId], references: [id])

  // A book may be written by several authors and issued by several publishers.
  authors    BookAuthor[]
  publishers BookPublisher[]

  // Academic placement. A book may be attached at any depth: to a whole
  // speciality, to a study year, or to an individual subject.
  fields   BookOnField[]
  years    BookOnYear[]
  subjects BookOnSubject[]

  /// Every picture of the book in display order — a series shows each volume.
  images BookImage[]

  inventory      Inventory?
  orderItems     OrderItem[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]

  @@index([storeId, title])
  @@index([titleNormalized])
  @@index([importJobId])
}

/// One picture of a book. position 0 is the cover and mirrors Book.imageUrl.
model BookImage {
  id       String @id @default(uuid())
  bookId   String
  url      String
  position Int    @default(0)

  createdAt DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, position])
}

// ================= REFERENCE TABLES =================

model Author {
  id   String @id @default(uuid())
  name String @unique

  books BookAuthor[]
}

model Publisher {
  id   String @id @default(uuid())
  name String @unique

  books BookPublisher[]
}

/// Join row linking a book to one of its authors. `position` drives display
/// order; position 0 is treated as the primary author.
model BookAuthor {
  bookId   String
  authorId String
  position Int    @default(0)

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([bookId, authorId])
  @@index([authorId])
  @@index([bookId, position])
}

/// Join row linking a book to one of its publishers (co-editions, reprints).
model BookPublisher {
  bookId      String
  publisherId String
  position    Int    @default(0)

  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  publisher Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  @@id([bookId, publisherId])
  @@index([publisherId])
  @@index([bookId, position])
}

model Country {
  id   String @id @default(uuid())
  name String @unique

  books Book[]
}

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  books Book[]
}

// ================= INVENTORY =================

model Inventory {
  id      String @id @default(uuid())
  bookId  String @unique
  storeId String

  stock  Int?
  status InventoryStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book  Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
}

// ================= ACADEMIC =================

model Field {
  id   String @id @default(uuid())
  name String @unique

  years AcademicYear[]
  books BookOnField[]
}

model AcademicYear {
  id      String @id @default(uuid())
  name    String
  fieldId String

  field    Field        @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  subjects Subject[]
  books    BookOnYear[]

  @@index([fieldId])
}

model Subject {
  id     String @id @default(uuid())
  name   String
  yearId String

  year  AcademicYear    @relation(fields: [yearId], references: [id], onDelete: Cascade)
  books BookOnSubject[]

  @@index([yearId])
}

/// A book attached to a whole speciality (e.g. every Sharia student needs it),
/// without being tied to a particular year or subject.
model BookOnField {
  bookId  String
  fieldId String

  book  Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([bookId, fieldId])
  @@index([fieldId])
}

/// A book attached to a whole study year of a speciality.
model BookOnYear {
  bookId String
  yearId String

  book Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  year AcademicYear @relation(fields: [yearId], references: [id], onDelete: Cascade)

  @@id([bookId, yearId])
  @@index([yearId])
}

/// A book attached to one specific subject.
model BookOnSubject {
  bookId    String
  subjectId String

  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([bookId, subjectId])
  @@index([subjectId])
}

// ================= REQUEST (lead) =================

model Request {
  id      String @id @default(uuid())
  storeId String

  firstName String
  lastName  String
  phone     String
  wilaya    String
  address   String
  bookId    String?
  bookName  String

  status RequestStatus

  // Link to the order created from this lead (when converted)
  convertedOrderId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store          Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  convertedOrder Order? @relation(fields: [convertedOrderId], references: [id], onDelete: SetNull)

  @@index([storeId, status])
}

// ================= ORDER =================

model Order {
  id      String @id @default(uuid())
  storeId String

  // Customer snapshot (denormalized — orders survive even if customer info changes elsewhere)
  firstName String
  lastName  String
  phone     String
  wilaya    String
  address   String

  status OrderStatus @default(pending)

  channel       SaleChannel    @default(online)
  paymentMethod PaymentMethod?

  // Money — denormalized totals so historical orders aren't affected by price changes
  subtotal     Decimal @default(0) @db.Decimal(10, 2)
  discount     Decimal @default(0) @db.Decimal(10, 2)
  shippingCost Decimal @default(0) @db.Decimal(10, 2)
  total        Decimal @default(0) @db.Decimal(10, 2)

  notes String?

  /// True while this order's books are taken out of stock. Set when it is
  /// confirmed (or sold at the counter), cleared when it is cancelled.
  stockApplied Boolean @default(false)

  /// Sequential invoice number ("2026-0007"), given the first time an
  /// invoice is printed. Unique per store.
  invoiceNumber String?
  invoicedAt    DateTime?

  /// Date of the sale when it differs from when it was recorded (imports).
  soldAt DateTime?

  importJobId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store   Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items   OrderItem[]
  request Request?

  @@unique([storeId, invoiceNumber])
  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@index([storeId, channel])
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  bookId  String

  // Snapshot fields so item rows don't break if a book is renamed/deleted
  bookTitle String
  unitPrice Decimal  @db.Decimal(10, 2)
  quantity  Int
  /// The book's purchase price when sold — keeps past profit right when
  /// prices change later. Null when the purchase price was unknown.
  unitCost  Decimal? @db.Decimal(10, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book  Book  @relation(fields: [bookId], references: [id])

  @@index([orderId])
}

// ================= DATA IMPORT =================

/// One spreadsheet imported through the admin wizard: what was done, and
/// enough to undo the books it created.
model ImportJob {
  id        String @id @default(uuid())
  storeId   String
  fileName  String
  sheetName String
  /// "catalog" (books, prices, stock). Later phases add sales, purchases…
  kind      String @default("catalog")
  /// "completed" | "undone"
  status    String @default("completed")

  created Int @default(0)
  updated Int @default(0)
  skipped Int @default(0)
  errors  Int @default(0)

  /// Column mapping and options used, for the history screen.
  mapping Json?

  createdAt DateTime  @default(now())
  undoneAt  DateTime?

  store Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  books Book[]

  @@index([storeId, createdAt])
}

// ================= MONEY =================

model Supplier {
  id      String  @id @default(uuid())
  storeId String
  name    String
  phone   String?
  email   String?
  address String?
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@unique([storeId, name])
}

/// Books bought from a supplier. Receiving it adds the books to stock.
model Purchase {
  id         String   @id @default(uuid())
  storeId    String
  supplierId String?
  /// The supplier's invoice / delivery note number.
  reference  String?
  date       DateTime @default(now())

  subtotal     Decimal @default(0) @db.Decimal(12, 2)
  shippingCost Decimal @default(0) @db.Decimal(12, 2)
  total        Decimal @default(0) @db.Decimal(12, 2)
  paidAmount   Decimal @default(0) @db.Decimal(12, 2)

  notes        String?
  /// False for history imported from a spreadsheet without touching stock.
  stockApplied Boolean @default(false)
  cancelled    Boolean @default(false)
  importJobId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  items    PurchaseItem[]

  @@index([storeId, date])
}

model PurchaseItem {
  id         String  @id @default(uuid())
  purchaseId String
  bookId     String?
  /// Snapshot, so the line stays readable if the book is renamed or deleted.
  bookTitle  String
  quantity   Int
  unitCost   Decimal @db.Decimal(10, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  book     Book?    @relation(fields: [bookId], references: [id], onDelete: SetNull)

  @@index([purchaseId])
  @@index([bookId])
}

model Expense {
  id            String         @id @default(uuid())
  storeId       String
  date          DateTime       @default(now())
  /// rent | salaries | transport | utilities | marketing | supplies | taxes | other
  category      String
  amount        Decimal        @db.Decimal(12, 2)
  description   String?
  paymentMethod PaymentMethod?
  importJobId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, date])
}

/// One change to a book's stock and why. The audit trail behind every number.
model StockMovement {
  id      String      @id @default(uuid())
  storeId String
  bookId  String
  delta   Int
  reason  StockReason
  /// The order / purchase that caused it.
  refId   String?
  note    String?

  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  book  Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([bookId, createdAt])
}

/// Per-store sequences (invoice numbers per year).
model StoreCounter {
  storeId String
  key     String
  value   Int    @default(0)

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([storeId, key])
}
