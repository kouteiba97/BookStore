generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= ENUMS =================

enum InventoryStatus {
  available
  on_request
  rare
}

enum RequestStatus {
  pending
  contacted
  done
}

enum OrderStatus {
  pending
  confirmed
  shipped
  delivered
  cancelled
}

// ================= CORE =================

model Store {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books       Book[]
  inventories Inventory[]
  requests    Request[]
  orders      Order[]
}

// ================= BOOK =================

model Book {
  id              String  @id @default(uuid())
  title           String
  titleNormalized String?

  /// Public blurb about the work itself, shown to shoppers on the book page
  /// under "عن الكتاب". Prose, free-form, may be empty.
  description String?

  /// Concrete cataloguing detail the title cannot carry — edition, number of
  /// volumes, binding, printing, condition, series. Shown on the book page
  /// under "معلومات إضافية".
  notes String?

  year  Int?
  price Decimal? @db.Decimal(10, 2)

  countryId  String?
  categoryId String
  storeId    String

  imageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])
  country  Country? @relation(fields: [countryId], references: [id])

  // A book may be written by several authors and issued by several publishers.
  authors    BookAuthor[]
  publishers BookPublisher[]

  // Academic placement. A book may be attached at any depth: to a whole
  // speciality, to a study year, or to an individual subject.
  fields   BookOnField[]
  years    BookOnYear[]
  subjects BookOnSubject[]

  inventory  Inventory?
  orderItems OrderItem[]

  @@index([storeId, title])
  @@index([titleNormalized])
}

// ================= REFERENCE TABLES =================

model Author {
  id   String @id @default(uuid())
  name String @unique

  books BookAuthor[]
}

model Publisher {
  id   String @id @default(uuid())
  name String @unique

  books BookPublisher[]
}

/// Join row linking a book to one of its authors. `position` drives display
/// order; position 0 is treated as the primary author.
model BookAuthor {
  bookId   String
  authorId String
  position Int    @default(0)

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@id([bookId, authorId])
  @@index([authorId])
  @@index([bookId, position])
}

/// Join row linking a book to one of its publishers (co-editions, reprints).
model BookPublisher {
  bookId      String
  publisherId String
  position    Int    @default(0)

  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  publisher Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  @@id([bookId, publisherId])
  @@index([publisherId])
  @@index([bookId, position])
}

model Country {
  id   String @id @default(uuid())
  name String @unique

  books Book[]
}

model Category {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  books Book[]
}

// ================= INVENTORY =================

model Inventory {
  id      String @id @default(uuid())
  bookId  String @unique
  storeId String

  stock  Int?
  status InventoryStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book  Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
}

// ================= ACADEMIC =================

model Field {
  id   String @id @default(uuid())
  name String @unique

  years AcademicYear[]
  books BookOnField[]
}

model AcademicYear {
  id      String @id @default(uuid())
  name    String
  fieldId String

  field    Field        @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  subjects Subject[]
  books    BookOnYear[]

  @@index([fieldId])
}

model Subject {
  id     String @id @default(uuid())
  name   String
  yearId String

  year  AcademicYear    @relation(fields: [yearId], references: [id], onDelete: Cascade)
  books BookOnSubject[]

  @@index([yearId])
}

/// A book attached to a whole speciality (e.g. every Sharia student needs it),
/// without being tied to a particular year or subject.
model BookOnField {
  bookId  String
  fieldId String

  book  Book  @relation(fields: [bookId], references: [id], onDelete: Cascade)
  field Field @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([bookId, fieldId])
  @@index([fieldId])
}

/// A book attached to a whole study year of a speciality.
model BookOnYear {
  bookId String
  yearId String

  book Book         @relation(fields: [bookId], references: [id], onDelete: Cascade)
  year AcademicYear @relation(fields: [yearId], references: [id], onDelete: Cascade)

  @@id([bookId, yearId])
  @@index([yearId])
}

/// A book attached to one specific subject.
model BookOnSubject {
  bookId    String
  subjectId String

  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([bookId, subjectId])
  @@index([subjectId])
}

// ================= REQUEST (lead) =================

model Request {
  id      String @id @default(uuid())
  storeId String

  firstName String
  lastName  String
  phone     String
  wilaya    String
  address   String
  bookId    String?
  bookName  String

  status RequestStatus

  // Link to the order created from this lead (when converted)
  convertedOrderId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store          Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  convertedOrder Order? @relation(fields: [convertedOrderId], references: [id], onDelete: SetNull)

  @@index([storeId, status])
}

// ================= ORDER =================

model Order {
  id      String @id @default(uuid())
  storeId String

  // Customer snapshot (denormalized — orders survive even if customer info changes elsewhere)
  firstName String
  lastName  String
  phone     String
  wilaya    String
  address   String

  status OrderStatus @default(pending)

  // Money — denormalized totals so historical orders aren't affected by price changes
  subtotal     Decimal @default(0) @db.Decimal(10, 2)
  shippingCost Decimal @default(0) @db.Decimal(10, 2)
  total        Decimal @default(0) @db.Decimal(10, 2)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store   Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items   OrderItem[]
  request Request?

  @@index([storeId, status])
  @@index([storeId, createdAt])
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  bookId  String

  // Snapshot fields so item rows don't break if a book is renamed/deleted
  bookTitle String
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  book  Book  @relation(fields: [bookId], references: [id])

  @@index([orderId])
}
